DATABASE_URL=postgresql://postgres:postgres@localhost:5432/obsi_support
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_PUBLIC_URL=http://localhost:3000
OUTBORN_ACCOUNT_AUTH_URL=https://account.example.com
OUTBORN_ACCOUNT_OAUTH_CLIENT_ID=outborn-obsi-support-web
# Optional suite integrations
OUTBORN_CORE_BASE_URL=
APPKIT_BASE_URL=
# Shared Obsi Knowledgebase. Disabled by default; Support must remain fully usable without it.
OBSI_KNOWLEDGEBASE_ENABLED=false
OBSI_KNOWLEDGEBASE_URL=
OBSI_KNOWLEDGEBASE_REQUEST_TIMEOUT_MS=1800
# Email transport (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SUPPORT_EMAIL_FROM=Obsi Support <support@example.com>
SUPPORT_EMAIL_DOMAIN=support.example.com
SUPPORT_EMAIL_REPLY_TO=
PGSSLMODE=disable
